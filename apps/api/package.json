{
  "name": "@maxr/api",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js Express TypeScript API for MAXR Teamspace",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:migrate": "node dist/db/migrator.js",
    "db:seed": "node dist/db/seeder.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "openapi:generate": "npm run build && node dist/openapi/generate.js",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@maxr/shared": "*",
    "@node-rs/argon2": "^2.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.1",
    "ioredis": "^5.4.1",
    "nodemailer": "^10.3.0",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
