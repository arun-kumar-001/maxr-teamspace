{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "outDir": "./dist",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@maxr/shared": ["../../packages/shared/dist/index.d.ts"],
      "@maxr/shared/*": ["../../packages/shared/dist/*"]
    }
  },
  "include": ["src/**/*", "e2e/**/*", "vite.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist"]
}
