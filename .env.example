# ==============================================================================
# MAXR Teamspace (MAXR ONE Staff Management) - Safe Environment Template
# Copy this file to .env for local development. Never commit real secrets.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Frontend Web Application URL (for CORS)
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL 16 via Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maxr_teamspace
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maxr_teamspace
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Redis Configuration (Temporary session cache & rate-limiting)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Session & Security
# Generate a secure 64-character hex secret for production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-secure-random-secret-in-production-min-32-chars
SESSION_MAX_AGE_MS=86400000

# Logging
LOG_LEVEL=debug

# Object Storage (Adobe S3Mock via Docker Compose: a local S3-compatible fake; credentials are not checked)
# local | memory. "s3" (Cantobo) is rejected until decision D-10 is answered.
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9090
S3_PORT=9090
S3_BUCKET=maxr-private-storage
S3_ACCESS_KEY=local-access-key
S3_SECRET_KEY=local-secret-key
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE_MB=10

# Email Testing Sink (Mailpit via Docker Compose)
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@maxr.internal


# HTTP layer
# Number of reverse proxies in front of the API (0 locally, 1 behind Nginx). Wrong values allow IP spoofing.
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Shared services (audit, notifications, storage). See docs/architecture/shared-services.md
# smtp (Mailpit locally) | sendgrid | fake (tests only, not allowed in production)
EMAIL_DRIVER=smtp
SENDGRID_API_KEY=
OUTBOX_POLL_INTERVAL_MS=10000
OUTBOX_MAX_ATTEMPTS=5
# Min 32 characters. REQUIRED in production. Leave empty in development (random per start).
STORAGE_SIGNING_SECRET=
# Download link lifetime in seconds (max 900)
STORAGE_LINK_TTL_SECONDS=300
# Must be true in production (a virus scanner has to be configured)
STORAGE_REQUIRE_SCAN=false

# Authentication and sessions (docs/architecture/auth.md)
# Absolute lifetime is SESSION_MAX_AGE_MS (above); idle timeout in milliseconds
SESSION_IDLE_TIMEOUT_MS=7200000
# Failed sign-ins per account before lockout, and the lockout window
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_WINDOW_MS=900000
# Requests to POST /auth/login per IP
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Must be true in production (default). Set false only for plain-HTTP local testing.
# AUTH_COOKIE_SECURE=true
