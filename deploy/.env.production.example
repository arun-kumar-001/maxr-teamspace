# Copy to deploy/.env.production (git-ignored) and fill in real values.
# Generate each secret with:  openssl rand -base64 48 | tr -d '\n'
# Never reuse the development placeholders from the root .env.example.

# Database / Redis (passwords only exist inside the compose network)
DB_USER=maxr
DB_NAME=maxr_teamspace
DB_PASSWORD=
REDIS_PASSWORD=

# Edge
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=/etc/maxr/certs

# API (read via env_file; the compose file builds DATABASE_URL and REDIS_URL itself)
SESSION_SECRET=
STORAGE_SIGNING_SECRET=
CORS_ORIGIN=https://teamspace.example.com
LOG_LEVEL=info

# Email (EMAIL_DRIVER=fake is refused in production)
EMAIL_DRIVER=smtp
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=

# Storage: the API only accepts the durable local driver in production until decision D-10 (Cantobo) is answered
STORAGE_DRIVER=local
