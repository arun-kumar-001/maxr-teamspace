# syntax=docker/dockerfile:1
# Build context: repository root (docker build -f deploy/Dockerfile.web .)

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci
COPY packages/shared packages/shared
COPY apps/web apps/web
RUN npm run build:web

# Unprivileged nginx: listens on 8080 (HTTP redirect) and 8443 (TLS); compose maps 80/443.
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx/api-proxy.conf deploy/nginx/security-headers.conf /etc/nginx/
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 8080 8443
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/healthz || exit 1
